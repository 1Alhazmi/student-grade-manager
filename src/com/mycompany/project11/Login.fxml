<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="CENTER" spacing="10"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.mycompany.project11.LoginController">

    <Label text="Login" style="-fx-font-size: 24px; -fx-font-weight: bold;"/>

    <TextField fx:id="usernameField" promptText="Username" maxWidth="200"/>

    <PasswordField fx:id="passwordField" promptText="Password" maxWidth="200"/>

    <Button text="Login" onAction="#handleLogin" prefWidth="100"/>

    <Label fx:id="messageLabel" textFill="red"/>

</VBox>