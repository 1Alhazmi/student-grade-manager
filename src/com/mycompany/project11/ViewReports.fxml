<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="CENTER" spacing="15"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.mycompany.project11.ViewReportsController">

    <Label text="Students Grades Report" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>

    <TextArea fx:id="reportArea" prefWidth="400" prefHeight="250" editable="false" 
              style="-fx-font-family: monospace;"/>

    <Button text="Back to Dashboard" onAction="#handleBack" prefWidth="150"/>

</VBox>